# 이 파일을 .env.local 로 복사한 뒤 실제 값을 입력하세요.
# .env.local 은 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.

# ─────────────────────────────────────────────
# Notion (필수) — 콘텐츠의 Source of Truth
# ─────────────────────────────────────────────
# 서버 사이드에서만 사용합니다. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
#
# NOTION_API_KEY   : notion.so/my-integrations 에서 Internal Integration 생성 후 발급받는 시크릿 키
# NOTION_*_DB_ID   : 각 데이터베이스를 브라우저에서 열었을 때 URL 에 포함된 32자리 값
#                    (각 DB 페이지의 ··· → "연결 추가" 로 위 Integration 을 먼저 연결해야 조회됩니다)
NOTION_API_KEY=ntn_your-integration-token
NOTION_PROFILE_DB_ID=00000000000000000000000000000000
NOTION_CAREER_DB_ID=00000000000000000000000000000000
NOTION_PROJECTS_DB_ID=00000000000000000000000000000000

# ─────────────────────────────────────────────
# Supabase (MVP 미사용)
# ─────────────────────────────────────────────
# 스타터킷 잔재입니다. MVP 범위에서는 캐싱을 ISR 로 처리하므로 설정할 필요가 없습니다.
# (docs/PRD.md "조회 방식" 참고)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
