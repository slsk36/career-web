# 이 파일을 .env.local 로 복사한 뒤 실제 값을 입력하세요.
# .env.local 은 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.

# ─────────────────────────────────────────────
# Notion (필수) — 콘텐츠의 Source of Truth
# ─────────────────────────────────────────────
# 서버 사이드에서만 사용합니다. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
#
# NOTION_API_KEY   : notion.so/my-integrations 에서 Internal Integration 생성 후 발급받는 시크릿 키
# NOTION_*_DB_ID   : 각 데이터베이스를 브라우저에서 열었을 때 URL 에 포함된 32자리 값
#                    (각 DB 페이지의 ··· → "연결 추가" 로 위 Integration 을 먼저 연결해야 조회됩니다)
NOTION_API_KEY=ntn_your-integration-token
NOTION_PROFILE_DB_ID=00000000000000000000000000000000
NOTION_CAREER_DB_ID=00000000000000000000000000000000
NOTION_PROJECTS_DB_ID=00000000000000000000000000000000

# ─────────────────────────────────────────────
# 사이트 URL (선택)
# ─────────────────────────────────────────────
# OG 메타태그 · canonical · sitemap · robots 에 쓰이는 절대 URL 입니다.
# 비워두면 Vercel 환경변수(VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL)를 쓰고,
# 그것도 없으면 http://localhost:3000 으로 폴백합니다.
# 커스텀 도메인을 연결하면 여기에 그 주소를 넣으세요. (예: https://example.com)
# 서버에서만 쓰므로 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
# SITE_URL=https://example.com

# ─────────────────────────────────────────────
# 재생성 트리거 (선택)
# ─────────────────────────────────────────────
# POST /api/revalidate 에서 검증하는 시크릿입니다.
# 설정하지 않으면 해당 엔드포인트는 503 으로 막힙니다(열린 채로 배포되는 사고 방지).
# 노션을 고친 뒤 ISR 주기(1시간)를 기다리지 않고 즉시 반영하고 싶을 때 씁니다.
#
#   curl -X POST https://example.com/api/revalidate \
#     -H "Content-Type: application/json" \
#     -d '{"secret":"...","path":"/"}'
#
# 충분히 긴 임의 문자열을 쓰세요. (예: openssl rand -base64 32)
# REVALIDATE_SECRET=your-long-random-secret

# ─────────────────────────────────────────────
# Supabase (MVP 미사용)
# ─────────────────────────────────────────────
# 스타터킷 잔재입니다. MVP 범위에서는 캐싱을 ISR 로 처리하므로 설정할 필요가 없습니다.
# (docs/PRD.md "조회 방식" 참고)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
